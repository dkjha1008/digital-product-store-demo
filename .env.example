# Database (Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/digital_store

# Session signing secret (min 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# App URL (used for Stripe redirects)
APP_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Neon Object Storage (S3-compatible)
# Leave AWS_ACCESS_KEY_ID empty to use local filesystem in development
AWS_ENDPOINT_URL_S3=https://your-branch.storage.c-5.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=digital-products
